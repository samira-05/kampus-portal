<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - KampusPortal</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/KampusPortal.styles.css" asp-append-version="true" />
</head>
<body class="kp-body d-flex flex-column min-vh-100">
    @{
        var currentController = ViewContext.RouteData.Values["Controller"]?.ToString() ?? "";
        var currentAction = ViewContext.RouteData.Values["Action"]?.ToString() ?? "";
    }

    <header class="pt-3 pb-2">
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand d-inline-flex align-items-center gap-2 fw-bold" asp-controller="Home" asp-action="Index" style="letter-spacing: -0.02em;">
                    <span class="d-inline-flex align-items-center justify-content-center rounded-circle"
                          style="width: 34px; height: 34px; background: linear-gradient(135deg, #7c3aed 0%, #ec4899 100%); box-shadow: 0 6px 14px rgba(124, 58, 237, 0.2);">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                        </svg>
                    </span>
                    <span style="color: var(--kp-navy, #1e1b4b);">
                        Kampus<span style="display: inline-block; background: linear-gradient(135deg, #7c3aed 0%, #ec4899 100%) !important; background-color: transparent !important; -webkit-background-clip: text !important; -webkit-text-fill-color: transparent !important; background-clip: text !important; text-decoration: none !important;">Portal</span>
                    </span>
                </a>

                <div class="d-flex flex-wrap align-items-center gap-1 gap-sm-2">
                    <a asp-controller="Home" asp-action="Index"
                       class="kp-nav-link text-decoration-none d-inline-flex align-items-center gap-2 @(currentController == "Home" && currentAction == "Index" ? "active" : "")">
                        <i class="bi bi-house-door-fill"></i>
                        <span>Ana Sayfa</span>
                    </a>

                    <a asp-controller="Clubs" asp-action="Index"
                       class="kp-nav-link text-decoration-none d-inline-flex align-items-center gap-2 @(currentController == "Clubs" ? "active" : "")">
                        <i class="bi bi-people-fill"></i>
                        <span>Kulüpler</span>
                    </a>

                    <a asp-controller="Events" asp-action="Index"
                       class="kp-nav-link text-decoration-none d-inline-flex align-items-center gap-2 @(currentController == "Events" ? "active" : "")">
                        <i class="bi bi-calendar-event-fill"></i>
                        <span>Etkinlikler</span>
                    </a>
                </div>
            </div>
        </nav>
    </header>

    <main class="flex-grow-1">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <footer class="py-4 mt-4">
        <div class="container text-center small" style="color: var(--kp-muted);">
            KampusPortal &copy; @DateTime.Now.Year
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>