@model IEnumerable<KampusPortal.Models.Event>

@{
    ViewData["Title"] = "Ana Sayfa";
}

<div class="mb-4">
    <h2>Yaklaşan Etkinlikler</h2>
    <p class="text-muted">Kampüsteki güncel kulüp etkinliklerini buradan takip edebilirsiniz.</p>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Şu an planlanmış yaklaşan bir etkinlik bulunmuyor.
    </div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Etkinlik</th>
                <th>Kulüp</th>
                <th>Tarih</th>
                <th>Yer</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Title</td>
                    <td>@item.Club?.Name</td>
                    <td>@item.EventDate.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>@item.Location</td>
                </tr>
            }
        </tbody>
    </table>
}