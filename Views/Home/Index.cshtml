@model IEnumerable<KampusPortal.Models.Event>
@using KampusPortal.Models

@{
    ViewData["Title"] = "Ana Sayfa";
    var featuredClubs = ViewBag.FeaturedClubs as List<Club> ?? new List<Club>();
}

<style>
    .kp-unified-stage {
        background: rgba(255, 255, 255, 0.90);
        border: 1px solid #ffffff;
        border-radius: 28px;
        padding: 1.65rem;
        box-shadow: 0 16px 38px rgba(34, 38, 75, 0.07);
    }

    .kp-hero-zone {
        background: #e8e6f8;
        border-radius: 22px;
        padding: 1.5rem 1.75rem;
        box-shadow: 0 12px 28px rgba(74, 66, 150, 0.06);
        margin-bottom: 1.5rem;
        overflow: hidden;
    }

    .kp-hero-art {
        max-height: 250px;
        width: 100%;
        object-fit: contain;
        transform: scale(1.85, 1.55);
        transform-origin: center center;
        mix-blend-mode: multiply;
    }

    .kp-showcase-card {
        position: relative;
        background: linear-gradient(165deg, #ffffff 0%, #f5f3fc 68%, #fdf6f2 100%);
        border: 1px solid rgba(114, 102, 214, 0.16);
        border-radius: 22px;
        padding: 1.25rem;
        height: 100%;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        box-shadow: 0 10px 24px rgba(74, 66, 150, 0.06);
        transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    }

        .kp-showcase-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: var(--kp-card-bar, linear-gradient(90deg, #5b4cf5, #3b82f6));
        }

        .kp-showcase-card:hover {
            transform: translateY(-4px);
            border-color: rgba(91, 76, 245, 0.34);
            box-shadow: 0 16px 30px rgba(74, 66, 150, 0.11);
        }

    .kp-bar-teknoloji {
        --kp-card-bar: linear-gradient(90deg, #2563eb, #3b82f6);
    }

    .kp-bar-sanat {
        --kp-card-bar: linear-gradient(90deg, #e11d48, #f43f5e);
    }

    .kp-bar-spor {
        --kp-card-bar: linear-gradient(90deg, #059669, #10b981);
    }

    .kp-bar-sosyal {
        --kp-card-bar: linear-gradient(90deg, #d97706, #f59e0b);
    }

    .kp-events-panel {
        background: linear-gradient(180deg, #f6f4fc 0%, #fcf7f4 100%);
        border: 1px solid rgba(114, 102, 214, 0.15);
        border-radius: 22px;
        padding: 0.95rem 1rem;
    }

    .kp-event-row {
        position: relative;
        overflow: hidden;
        background: #ffffff;
        border: 1px solid #ece8f8;
        border-radius: 13px;
        padding: 0.48rem 0.65rem 0.48rem 0.9rem;
        transition: transform 0.15s ease, border-color 0.15s ease;
    }

        .kp-event-row::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            bottom: 0;
            width: 4px;
            background-color: var(--kp-event-accent, #d97706);
        }

        .kp-event-row:hover {
            transform: translateX(3px);
            border-color: #cfc7ee;
        }

    @@media (max-width: 575.98px) {
        .kp-unified-stage {
            padding: 1rem;
            border-radius: 20px;
        }

        .kp-hero-zone {
            padding: 1.1rem;
            border-radius: 16px;
        }

        .kp-hero-art {
            transform: none;
            max-height: 190px;
        }

        .kp-hero-zone form.rounded-pill {
            border-radius: 20px !important;
            padding: 0.5rem 0.65rem !important;
        }
    }

    }
</style>

<section class="py-3">
    <div class="kp-unified-stage">

        <div class="kp-hero-zone">
            <div class="row align-items-center g-4">
                <div class="col-12 col-lg-6 position-relative" style="z-index: 5;">
                    <h1 class="fw-bold mb-2" style="color: var(--kp-navy); font-size: clamp(2rem, 3.8vw, 2.7rem); letter-spacing: -0.02em;">
                        Kulüpleri Keşfet!
                    </h1>
                    <p class="mb-4" style="color: var(--kp-muted); font-size: 1.03rem; max-width: 520px;">
                        İlgi alanına uygun topluluğu bul, kampüs yaşamına yön ver.
                    </p>

                    <form asp-controller="Clubs" asp-action="Index" method="get"
                          class="bg-white p-2 rounded-pill shadow-sm d-flex flex-wrap flex-md-nowrap align-items-center gap-2 overflow-hidden">
                        <div class="d-flex align-items-center flex-grow-1 min-w-0 ps-2 ps-md-3">
                            <i class="bi bi-search me-2 flex-shrink-0" style="color: var(--kp-muted);"></i>
                            <input type="text"
                                   name="searchString"
                                   class="form-control border-0 bg-transparent shadow-none py-1 min-w-0"
                                   placeholder="Kulüp adına göre ara..." />
                        </div>

                        <div class="border-start d-none d-md-block" style="height: 24px; border-color: var(--kp-border) !important;"></div>

                        <select name="categoryFilter"
                                asp-items="Html.GetEnumSelectList<ClubCategory>()"
                                class="form-select border-0 bg-transparent shadow-none py-1 w-auto min-w-0"
                                style="color: var(--kp-text); font-weight: 500; font-size: 0.9rem;">
                            <option value="">-- Tüm Kategoriler --</option>
                        </select>

                        <button type="submit" class="kp-btn-navy px-3 px-md-4 py-2 flex-shrink-0">
                            Filtrele
                        </button>
                    </form>
                </div>

                <div class="col-12 col-lg-6 d-flex justify-content-center align-items-center position-relative" style="z-index: 1;">
                    <img src="~/images/kampus-ogrenciler.jpg"
                         alt="Kampüste vakit geçiren öğrenciler"
                         class="kp-hero-art" />
                </div>
            </div>
        </div>

        <div class="row g-4 align-items-start">
            <div class="col-12 col-xl-8">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                    <div>
                        <h2 class="h4 fw-bold mb-0" style="color: var(--kp-navy);">
                            Öne Çıkan Kulüpler
                        </h2>
                    </div>

                    <a asp-controller="Clubs" asp-action="Create" class="kp-btn-coral text-decoration-none d-inline-flex align-items-center gap-1">
                        <i class="bi bi-plus-lg"></i>
                        <span>Yeni Kulüp Ekle</span>
                    </a>
                </div>

                @if (!featuredClubs.Any())
                {
                    <div class="kp-showcase-card text-center py-4">
                        <span class="fs-2 d-block mb-2">🏛️</span>
                        <p class="mb-0 small" style="color: var(--kp-muted);">Henüz kulüp kaydı bulunmuyor.</p>
                    </div>
                }
                else
                {
                    <div class="row row-cols-1 row-cols-md-3 g-3">
                        @foreach (var club in featuredClubs)
                        {
                            var (badgeClass, emojiIcon, iconBg, barClass) = club.Category switch
                            {
                                ClubCategory.Teknoloji => ("kp-cat-teknoloji", "💻", "background: #dbeafe; color: #1d4ed8;", "kp-bar-teknoloji"),
                                ClubCategory.Sanat => ("kp-cat-sanat", "🎭", "background: #ffe4e6; color: #be123c;", "kp-bar-sanat"),
                                ClubCategory.Spor => ("kp-cat-spor", "🏆", "background: #d1fae5; color: #047857;", "kp-bar-spor"),
                                _ => ("kp-cat-sosyal", "🤝", "background: #fef3c7; color: #b45309;", "kp-bar-sosyal")
                            };

                            <div class="col">
                                <article class="kp-showcase-card @barClass">
                                    <div class="d-flex align-items-center gap-2 mb-3">
                                        <span class="kp-icon-box" style="@iconBg">
                                            @emojiIcon
                                        </span>
                                        <span class="kp-cat-pill @badgeClass">@club.Category</span>
                                    </div>

                                    <h3 class="h6 fw-bold mb-1" style="color: var(--kp-navy);">
                                        @club.Name
                                    </h3>

                                    <p class="small mb-3 flex-grow-1" style="color: var(--kp-muted); line-height: 1.55;">
                                        @(string.IsNullOrWhiteSpace(club.Description)
                                            ? "Bu kulüp için henüz açıklama eklenmemiş."
                                            : club.Description)
                                    </p>

                                    <div class="d-flex align-items-center justify-content-between gap-1 pt-2 border-top" style="border-color: rgba(114, 102, 214, 0.12) !important;">
                                        <a asp-controller="Clubs" asp-action="Details" asp-route-id="@club.Id" class="kp-btn-navy text-decoration-none d-inline-flex align-items-center gap-1">
                                            <span>İncele</span>
                                            <i class="bi bi-arrow-right"></i>
                                        </a>

                                        <div class="d-flex align-items-center gap-1">
                                            <a asp-controller="Clubs" asp-action="Edit" asp-route-id="@club.Id" class="kp-btn-ghost text-decoration-none">
                                                Düzenle
                                            </a>
                                            <a asp-controller="Clubs" asp-action="Delete" asp-route-id="@club.Id" class="kp-btn-ghost kp-btn-danger-ghost text-decoration-none">
                                                Sil
                                            </a>
                                        </div>
                                    </div>
                                </article>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="col-12 col-xl-4">
                <div class="kp-events-panel">
                    <div class="d-flex justify-content-between align-items-center gap-2 mb-3 pb-2 border-bottom" style="border-color: #e2dcf3 !important;">
                        <h2 class="h6 fw-bold mb-0 d-flex align-items-center gap-2" style="color: var(--kp-navy);">
                            <span>📅</span>
                            <span>Yaklaşan Etkinlikler</span>
                        </h2>

                        <a asp-controller="Events" asp-action="Index" class="small text-decoration-none fw-semibold" style="color: var(--kp-muted);">
                            Tüm Etkinlikler Gör &rarr;
                        </a>
                    </div>

                    @if (!Model.Any())
                    {
                        <div class="text-center py-4">
                            <span class="fs-3 d-block mb-1">🗓️</span>
                            <p class="mb-0 small" style="color: var(--kp-muted);">
                                Şu an planlanmış yaklaşan bir etkinlik bulunmuyor.
                            </p>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-2">
                            @foreach (var item in Model)
                            {
                                var (catPill, dotColor) = item.Club?.Category switch
                                {
                                    ClubCategory.Teknoloji => ("kp-cat-teknoloji", "#2563eb"),
                                    ClubCategory.Sanat => ("kp-cat-sanat", "#e11d48"),
                                    ClubCategory.Spor => ("kp-cat-spor", "#059669"),
                                    _ => ("kp-cat-sosyal", "#d97706")
                                };

                                <div class="kp-event-row" style="--kp-event-accent: @dotColor;">
                                    <div class="d-flex align-items-start gap-2">
                                        <span class="kp-date-badge flex-shrink-0 mt-1">
                                            <span class="day">@item.EventDate.ToString("dd")</span>
                                            <span class="month">@item.EventDate.ToString("MMM")</span>
                                        </span>

                                        <div style="min-width: 0; flex: 1 1 auto;">
                                            <h3 class="small fw-bold mb-1" style="color: var(--kp-navy); font-size: 0.84rem; line-height: 1.3; word-break: break-word;">
                                                <a asp-controller="Events" asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none" style="color: inherit;">
                                                    @item.Title
                                                </a>
                                            </h3>

                                            <div class="small mb-1" style="color: var(--kp-muted); font-size: 0.73rem; line-height: 1.35;">
                                                @if (item.Club != null)
                                                {
                                                    <span class="fw-semibold" style="color: var(--kp-text);">@item.Club.Name</span>
                                                    <span> • </span>
                                                }
                                                <span class="text-nowrap">🕒 @item.EventDate.ToString("HH:mm")</span>
                                            </div>

                                            <div class="small mb-1" style="color: var(--kp-muted); font-size: 0.72rem; line-height: 1.3; word-break: break-word;">
                                                📍 @item.Location
                                            </div>

                                            @if (item.Club != null)
                                            {
                                                <div class="mt-1">
                                                    <span class="kp-cat-pill @catPill d-inline-block text-nowrap"
                                                          style="font-size: 0.66rem; padding: 0.14rem 0.55rem;">
                                                        @item.Club.Category
                                                    </span>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>