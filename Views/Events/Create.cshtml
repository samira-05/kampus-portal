@model Event
@using Microsoft.AspNetCore.Mvc.Rendering
@using Microsoft.EntityFrameworkCore

@{
    ViewData["Title"] = "Yeni Etkinlik Ekle";

    IEnumerable<SelectListItem> clubOptions =
        ViewBag.ClubId as IEnumerable<SelectListItem>
        ?? ViewBag.Clubs as IEnumerable<SelectListItem>;

    if (clubOptions == null)
    {
        var dbContext = Context.RequestServices.GetService(typeof(DbContext)) as DbContext;
        if (dbContext != null)
        {
            var clubsProperty = dbContext.GetType().GetProperty("Clubs")?.GetValue(dbContext) as System.Collections.IEnumerable;
            if (clubsProperty != null)
            {
                clubOptions = clubsProperty.Cast<object>()
                    .Select(c => new SelectListItem
                    {
                        Value = c.GetType().GetProperty("Id")?.GetValue(c)?.ToString(),
                        Text = c.GetType().GetProperty("Name")?.GetValue(c)?.ToString(),
                        Selected = Model != null && c.GetType().GetProperty("Id")?.GetValue(c)?.ToString() == Model.ClubId.ToString()
                    })
                    .ToList();
            }
        }
    }
}

<div class="row justify-content-center my-4">
    <div class="col-md-8 col-lg-6">
        <div class="bg-white rounded-4 shadow-sm p-4 p-md-5" style="border: 1px solid rgba(99, 102, 241, 0.12);">
            <h1 class="h4 fw-bold mb-4" style="color: #1e1b4b;">Yeni Etkinlik Ekle</h1>

            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="ClubId" class="form-label fw-semibold" style="color: #1e1b4b;">Kulüp</label>
                    <select asp-for="ClubId" asp-items="clubOptions" class="form-select rounded-3">
                        <option value="">-- Kulüp Seçin --</option>
                    </select>
                    <span asp-validation-for="ClubId" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Title" class="form-label fw-semibold" style="color: #1e1b4b;">Etkinlik Başlığı</label>
                    <input asp-for="Title" class="form-control rounded-3" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="EventDate" class="form-label fw-semibold" style="color: #1e1b4b;">Tarih ve Saat</label>
                    <input asp-for="EventDate" type="datetime-local" class="form-control rounded-3" />
                    <span asp-validation-for="EventDate" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Location" class="form-label fw-semibold" style="color: #1e1b4b;">Konum</label>
                    <input asp-for="Location" class="form-control rounded-3" />
                    <span asp-validation-for="Location" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Description" class="form-label fw-semibold" style="color: #1e1b4b;">Açıklama</label>
                    <textarea asp-for="Description" rows="4" class="form-control rounded-3"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="d-flex flex-wrap align-items-center gap-2">
                    <button type="submit" class="btn px-4 py-2 rounded-pill fw-semibold text-white" style="background: #6941c6;">
                        Kaydet
                    </button>
                    <a asp-action="Index" class="btn btn-light px-4 py-2 rounded-pill border">
                        İptal
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}