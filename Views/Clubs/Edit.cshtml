@model KampusPortal.Models.Club

<h2>Kulübü Düzenle</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />

    <div>
        <label asp-for="Name">Kulüp Adı</label><br />
        <input asp-for="Name" />
        <span asp-validation-for="Name" style="color:red"></span>
    </div>
    <br />
    <div>
        <label asp-for="Category">Kategori</label><br />
        <select asp-for="Category" asp-items="Html.GetEnumSelectList<KampusPortal.Models.ClubCategory>()"></select>
    </div>
    <br />
    <div>
        <label asp-for="Description">Açıklama</label><br />
        <textarea asp-for="Description"></textarea>
    </div>
    <br />
    <button type="submit">Güncelle</button>
    <a asp-action="Index">İptal</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}